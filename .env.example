# Base URL of the backend API. Change this any time the backend moves
# (a different port locally, a deployed URL, etc.) — no code changes needed.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Optional: only set this if the realtime (Socket.IO) server is NOT at the
# same host as the API above. By default it's derived from
# NEXT_PUBLIC_API_URL by dropping the trailing "/api".
# NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Optional: comma-separated STUN server URLs used for the host's WebRTC
# movie stream to guests. Defaults to public Google STUN servers if unset.
# NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# There is no TURN env var here on purpose. TURN is needed for guests on a
# different network than the host (different Wi-Fi, cellular data, or even
# "the same Wi-Fi" if the router doesn't support NAT hairpinning or has
# client isolation on) — STUN alone can't help there, and without TURN
# those connections just hang at "waiting for the host" forever. But TURN
# credentials come from an API key that must never sit in a NEXT_PUBLIC_
# variable (anyone could copy it out of the browser bundle and burn
# through the account's quota) — so the frontend instead asks our OWN
# backend for credentials (GET /api/turn/credentials), which holds the key
# server-side. See backend/.env's METERED_TURN_URL and
# backend/src/controllers/turnController.js.
