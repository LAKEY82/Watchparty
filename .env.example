# Base URL of the backend API. Change this any time the backend moves
# (a different port locally, a deployed URL, etc.) — no code changes needed.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Optional: only set this if the realtime (Socket.IO) server is NOT at the
# same host as the API above. By default it's derived from
# NEXT_PUBLIC_API_URL by dropping the trailing "/api".
# NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Optional: comma-separated STUN server URLs used for the host's WebRTC
# movie stream to guests. Defaults to public Google STUN servers if unset.
# NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional: TURN server config, for when STUN alone isn't enough — two
# peers on different networks, on a network with client isolation, or
# behind a router that doesn't support NAT hairpinning (a peer connecting
# to another device on its OWN network from outside can hit this even on
# "the same Wi-Fi"). Without a TURN server those connections just hang at
# "waiting for the host" forever.
#
# Defaults to the Open Relay Project (metered.ca) — free, no signup, shared
# public credentials, fair-use rate-limited. Fine to start with; switch to
# your own TURN account (Metered.ca, Twilio, self-hosted coturn, etc.) here
# if you outgrow it — no code changes needed either way.
# NEXT_PUBLIC_TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443
# NEXT_PUBLIC_TURN_USERNAME=openrelayproject
# NEXT_PUBLIC_TURN_CREDENTIAL=openrelayproject
